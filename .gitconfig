[core]
	editor = git-editor
	pager = delta
[user]
	name = Gabriel Saillard
	email = gabriel@saillard.dev
	signingkey = /Users/gaby/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/d6aa9028979c723ba3f27b4cb0c178e7.pub
[includeIf "hasconfig:remote.*.url:git@github.com:carbonfact/**"]
	email = gabriel@carbonfact.com
[includeIf "hasconfig:remote.*.url:https://github.com/carbonfact/**"]
	email = gabriel@carbonfact.com
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/carbonfact/**"]
	email = gabriel@carbonfact.com
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[diff]
    colorMoved = default
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true # use n and N to move between diff sections
	syntax-theme = ansi
	minus-style = syntax normal
	plus-style = syntax normal
	minus-emph-style = red bold normal
	plus-emph-style = green bold normal
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	line-numbers-zero-style = normal
	line-numbers-left-style = normal
	line-numbers-right-style = normal
	file-style = blue bold
	file-decoration-style = blue box
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = blue box
	keep-plus-minus-markers = true
[merge]
	conflictstyle = zdiff3
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[pull]
	rebase = true
	ff = only
[rebase]
	updateRefs = true
[push]
	default = current
	autoSetupRemote = true
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.gitallowedsigners
[fetch]
	prune = true
[maintenance]
	repo = /Users/gaby/git/carbonfact/carbonfact
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[http]
	sslCAInfo = /Library/Application Support/AikidoSecurity/EndpointProtection/run/endpoint-protection-openssl-combined-ca.pem
