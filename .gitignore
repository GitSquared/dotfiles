# Straylight's yadm branch is intentionally allowlist-only.
/*

!/.gitignore

!/.config/
/.config/*
!/.config/yadm/
/.config/yadm/*
!/.config/yadm/bootstrap
!/.config/yadm/hooks/
/.config/yadm/hooks/*
!/.config/yadm/hooks/pre_commit
!/.config/yadm/straylight/
!/.config/yadm/straylight/**

!/backup-scripts/
/backup-scripts/*
!/backup-scripts/backup-config.sh
!/backup-scripts/backup-storage.sh
!/backup-scripts/notify-failure.sh

!/straylight-docker/
/straylight-docker/*
!/straylight-docker/docker-compose.yml
!/straylight-docker/.env.example

!/straylight-docker/caddy/
/straylight-docker/caddy/*
!/straylight-docker/caddy/config/
/straylight-docker/caddy/config/*
!/straylight-docker/caddy/config/Caddyfile

!/straylight-docker/homeassistant/
/straylight-docker/homeassistant/*
!/straylight-docker/homeassistant/config/
/straylight-docker/homeassistant/config/*
!/straylight-docker/homeassistant/config/configuration.yaml
!/straylight-docker/homeassistant/config/automations.yaml
!/straylight-docker/homeassistant/config/scripts.yaml
!/straylight-docker/homeassistant/config/scenes.yaml
