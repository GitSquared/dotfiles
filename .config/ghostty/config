auto-update = check

# Kanagawa Wave theme
background = #1F1F28
foreground = #DCD7BA

palette = 0=#16161D
palette = 1=#C34043
palette = 2=#76946A
palette = 3=#C0A36E
palette = 4=#7E9CD8
palette = 5=#957FB8
palette = 6=#6A9589
palette = 7=#C8C093
palette = 8=#727169
palette = 9=#E82424
palette = 10=#98BB6C
palette = 11=#E6C384
palette = 12=#7FB4CA
palette = 13=#938AA9
palette = 14=#7AA2F7
palette = 15=#DCD7BA

cursor-color = #C8C093
selection-background = #2D4F67
selection-foreground = #C8C093
background-blur-radius = 20
background-opacity = 0.7
#background-opacity = 1

window-inherit-font-size = false
font-family = "JetBrains Mono"
font-size = 12
font-thicken = true

mouse-hide-while-typing = true
macos-option-as-alt = false

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell
notify-on-command-finish-after = 10s

keybind = global:ctrl+§=toggle_quick_terminal
keybind = ctrl+cmd+f=unbind
keybind = ctrl+cmd+z=unbind
keybind = ctrl+cmd+left=unbind
keybind = ctrl+cmd+right=unbind
keybind = opt+left=unbind
keybind = opt+right=unbind

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
window-padding-x = 10
window-padding-y = 8

keybind = shift+enter=text:\n
keybind = cmd+enter=text:\n