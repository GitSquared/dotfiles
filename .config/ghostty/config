auto-update = check

# Custom Rose Pine theme (modified)
background = #242424
foreground = #e0def4

palette = 0=#1e1e1e
palette = 1=#e74c3c
palette = 2=#95b1ac
palette = 3=#f6c177
palette = 4=#3e8fb0
palette = 5=#a29bfe
palette = 6=#9ccfd8
palette = 7=#e0def4
palette = 8=#707070
palette = 9=#e74c3c
palette = 10=#95b1ac
palette = 11=#f6c177
palette = 12=#3e8fb0
palette = 13=#a29bfe
palette = 14=#9ccfd8
palette = 15=#e0def4

cursor-color = #e0def4
selection-background = #3c3c3c
selection-foreground = #e0def4
background-blur-radius = 20
background-opacity = 0.75

window-inherit-font-size = false
font-size = 12
font-thicken = true

mouse-hide-while-typing = true
macos-option-as-alt = false

keybind = global:ctrl+§=toggle_quick_terminal
keybind = ctrl+cmd+f=unbind
keybind = ctrl+cmd+z=unbind
keybind = ctrl+cmd+left=unbind
keybind = ctrl+cmd+right=unbind
keybind = opt+left=unbind
keybind = opt+right=unbind

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
window-padding-x = 10
window-padding-y = 8

macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = #36A3D9
macos-icon-screen-color = #0F141A
keybind = shift+enter=text:\n
