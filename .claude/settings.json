{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_PostHog"
    },
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/gaby/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "carbonfact-common@carbonfact-plugins": true,
    "carbonfact-cops@carbonfact-plugins": false,
    "carbonfact-eng@carbonfact-plugins": true,
    "context-mode@context-mode": true,
    "aikido@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "carbonfact-plugins": {
      "source": {
        "source": "github",
        "repo": "carbonfact/claude-plugins"
      },
      "autoUpdate": true
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": true
    }
  },
  "syntaxHighlightingDisabled": false,
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
