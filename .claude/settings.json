{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_PostHog"
    },
    {
      "serverName": "claude_ai_Gmail"
    },
    {
      "serverName": "claude_ai_Google_Calendar"
    }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"/Users/gaby/.claude/hooks/pr-push-nudge.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gaby/.claude/hooks/session-status.py\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/gaby/.claude/hooks/session-status.py\" stop",
            "timeout": 15,
            "statusMessage": "Checking session status page"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "carbonfact-common@carbonfact-plugins": true,
    "carbonfact-cops@carbonfact-plugins": false,
    "carbonfact-eng@carbonfact-plugins": true,
    "aikido@claude-plugins-official": true,
    "carbonfact-science@carbonfact-plugins": false
  },
  "extraKnownMarketplaces": {
    "carbonfact-plugins": {
      "source": {
        "source": "github",
        "repo": "carbonfact/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "syntaxHighlightingDisabled": false,
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
