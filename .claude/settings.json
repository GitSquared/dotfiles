{
  "permissions": {
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/credentials*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "syntaxHighlightingDisabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
