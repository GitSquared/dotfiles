{
  "name": "straylight-linear-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./test/",
    "test:capsule": "node --test claude-capsule/agent-request.test.mjs claude-capsule/claude-request.test.mjs",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "pi-web-access": "0.18.0",
    "playwright-core": "1.62.0",
    "typebox": "1.3.7",
    "visual-explainer": "0.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.17.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.9",
    "protobufjs": "7.6.5",
    "undici": "8.10.0"
  }
}
